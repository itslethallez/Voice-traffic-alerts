# Neon Postgres connection string for a BRANCH database (Neon console ->
# Branches -> New branch off main). Never paste the prod DATABASE_URL
# from the repo-root .env in here - the e2e check refuses to run on it.
DATABASE_URL=postgres://...

# Shared secret required on POST /api/ingest (x-ingest-secret header).
# Any long random string for local dev.
INGEST_SECRET=dev-secret

# Upstash Redis (REST) - cache layer for the corridor query.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error tracking. Leave empty to disable locally.
SENTRY_DSN=
