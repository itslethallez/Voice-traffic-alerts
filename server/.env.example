# Neon Postgres connection string for a BRANCH database (Neon console ->
# Branches -> New branch off main). Never paste the prod DATABASE_URL
# from the repo-root .env in here - the e2e check refuses to run on it.
DATABASE_URL=postgres://...

# Per-source shared secrets for POST /api/ingest (x-ingest-secret
# header): the endpoint resolves the presented secret to ONE source and
# 403s on a payload claiming any other (see api/ingest.ts's
# SOURCE_INGEST_SECRET_ENV). Set only the sources that actually write;
# unset sources accept nothing. Any long random strings for local dev -
# keep them distinct across sources.
INGEST_SECRET_POLICE_NOTICE=dev-secret
# INGEST_SECRET_CROWD_API=
# INGEST_SECRET_FIXED_DB=
# INGEST_SECRET_FB_AGENT=
# INGEST_SECRET_USER_REPORT=

# Upstash Redis (REST) - cache layer for the corridor query.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error tracking. Leave empty to disable locally.
SENTRY_DSN=
