{
  "name": "shotgun-api",
  "version": "1.0.0",
  "private": true,
  "description": "Thin Vercel serverless API in front of the Neon Postgres database holding fixed camera locations and user-submitted reports. The Expo app never holds DB credentials directly - it only ever calls this.",
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@sentry/node": "^10.74.0",
    "@upstash/redis": "^1.38.4",
    "dotenv": "^18.0.0",
    "node-pg-migrate": "^9.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix ../shared --no-package-lock --ignore-scripts && npm run typecheck",
    "migrate": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "typecheck": "tsc"
  }
}
