# Copy this file to .env and fill in your OpenWeb Ninja API key.
# Get a key at https://www.openwebninja.com
#
# EXPO_PUBLIC_ variables are inlined into the JS bundle at build time,
# which means this key ships inside the app binary and is extractable
# by anyone who has the app. See the "API key" section in README.md
# before shipping this to real users.
EXPO_PUBLIC_WAZE_API_KEY=

# Mapbox (Step 11+, radar UI). Both come from https://account.mapbox.com/ -
# "Tokens" for the public one, "Tokens > secret scopes: DOWNLOADS:READ" for
# the download token.
#
# RNMAPBOX_MAPS_DOWNLOAD_TOKEN is a *secret* token, only used at
# build/prebuild time to fetch the native Mapbox Maps SDK for Android and
# iOS - Gradle and the Podfile both read it directly from the environment
# (this exact name; @rnmapbox/maps' own config-plugin prop for this is
# deprecated), never EXPO_PUBLIC_-prefixed, so it never ends up in the JS
# bundle. Required before `expo prebuild` / building a dev client for
# either platform will succeed. For an EAS Build (not a local build),
# this also needs to be set as an EAS secret/env var - a local .env file
# alone won't reach EAS's cloud build machines.
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=

# EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN is the *public* runtime token the map
# view itself uses - safe to ship in the bundle (Mapbox's public tokens
# are scoped/rate-limited for exactly this).
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Google Cloud Text-to-Speech (voice announcements). Create a key in a GCP
# project with the Text-to-Speech API enabled - either via Cloud Console
# (APIs & Services > Credentials) or Cloud Shell:
#   gcloud services enable texttospeech.googleapis.com --project=YOUR_PROJECT
#   gcloud services api-keys create --display-name="Text-to-Speech API Key" \
#     --api-target=service=texttospeech.googleapis.com --project=YOUR_PROJECT
# Like the Waze key, this ships inside the app binary and is extractable by
# anyone who has the app. If unset, announcements fall back to the
# on-device voice.
EXPO_PUBLIC_GOOGLE_TTS_API_KEY=

# Base URL of the deployed server/ Vercel project (e.g.
# https://shotgun-api.vercel.app/api/) - the thin proxy in front of the
# Neon database holding fixed cameras and user reports. Safe as a public
# EXPO_PUBLIC_ var: it's just a URL, not a credential - the actual
# DATABASE_URL stays server-side only, set as a Vercel env var, never here.
# If unset, manual reports won't sync and fixed cameras fall back to the
# bundled dataset.
EXPO_PUBLIC_BACKEND_API_URL=
